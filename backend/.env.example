# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

# PostgreSQL connection string.
# Local dev default (matches: choco install postgresql16 --params '/Password:devpassword' -y):
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/elevate_minds_dev"

# JWT signing secrets. Generate real random values locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT random value for each secret. Never reuse these example placeholders.
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string

# Access token lifetime (short-lived) and refresh token lifetime (long-lived, httpOnly cookie).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Port the Express server listens on.
PORT=4000

# Frontend origin, for CORS (credentials: true requires an explicit origin, not *).
FRONTEND_URL=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Stripe (Phase D, test mode only — never put a live/production key here).
# Leave blank until you have real Stripe test keys. The server boots fine and
# every non-payment route works with these empty; POST /api/donations/create-intent
# and the webhook route return 503 until both are filled in.
# Get STRIPE_SECRET_KEY from the Stripe Dashboard (Developers > API keys, "Secret key", test mode).
# Get STRIPE_WEBHOOK_SECRET by running the Stripe CLI locally:
#   stripe listen --forward-to localhost:4000/api/donations/webhook
# (that command prints a "whsec_..." value — paste it here.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
