# Copy to .env for local dev. Never commit the real .env (already gitignored at the repo root).

# Base URL of the backend API (see backend/.env.example PORT).
VITE_API_URL=http://localhost:4000/api

# Stripe publishable key (test mode — safe to expose client-side, unlike the
# secret key). Leave blank until you have a real "pk_test_..." key from the
# Stripe Dashboard (Developers > API keys). The Donate page shows a graceful
# "payments aren't configured yet" message instead of a broken form while
# this is empty or left as a placeholder.
VITE_STRIPE_PUBLISHABLE_KEY=
